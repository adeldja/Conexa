{
  "name": "conexa",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.22",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "yarn workspace api start:dev",
    "dev:web": "yarn workspace web dev",
    "db:start": "docker-compose -f docker-compose.dev.yml up -d",
    "db:stop": "docker-compose -f docker-compose.dev.yml down",
    "db:reset": "docker-compose -f docker-compose.dev.yml down -v && docker-compose -f docker-compose.dev.yml up -d",
    "start": "yarn db:start && sleep 3 && yarn dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "main": "index.js",
  "repository": "https://github.com/adeldja/Conexa.git",
  "author": "Adel djahnit <adeldjahnita@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "turbo": "^2.5.3",
    "concurrently": "^7.6.0"
  }
}
